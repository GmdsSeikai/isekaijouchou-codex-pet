{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GmdsSeikai/isekaijouchou-codex-pet/raw/main/schemas/pet.schema.json",
  "title": "Codex Pet Manifest v2",
  "type": "object",
  "required": [
    "id",
    "displayName",
    "description",
    "spriteVersionNumber",
    "spritesheetPath"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "spriteVersionNumber": {
      "const": 2
    },
    "spritesheetPath": {
      "const": "spritesheet.webp"
    }
  },
  "additionalProperties": false
}
